[Unit]
Description=Magnus computerd: starts and owns computer VMs
After=local-fs.target

[Service]
ExecStart=/usr/local/lib/magnus/magnus-computerd serve
Restart=always
RestartSec=2
# The VMs live in their own cgroups. Stopping this service must not touch
# them, nor their forwarders and open screen connections, which stay in this
# unit's cgroup: systemd's "left-over process" lines on a restart are those.
# The new computerd reads the running VMs from their cgroups.
KillMode=process

[Install]
WantedBy=multi-user.target
