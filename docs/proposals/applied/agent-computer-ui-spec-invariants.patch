+async fn bytes(who: &Api, path: &str, token: &str) -> (reqwest::StatusCode, Vec<u8>) {
+    let r = reqwest::Client::new().get(format!("{}{path}", who.base)).bearer_auth(token).send().await.unwrap();
+    (r.status(), r.bytes().await.unwrap().to_vec())
+}
