+/// Waits for a task to finish, accepting its deliverable if it asks.
+async fn settle_reviewed(who: &Api, task: &str) {
+    let t = who.wait_settled(task).await;
+    if t["status"] == "suspended" && t["waiting_on"] == "review" {
+        let review = who.wait_item(task, "review").await;
+        assert!(who.respond(review["id"].as_str().unwrap(), json!({ "decision": "accept" })).await.is_success());
+        who.wait_status(task, &["completed"]).await;
+    } else {
+        assert_eq!(t["status"], "completed", "{t}");
+    }
+}
