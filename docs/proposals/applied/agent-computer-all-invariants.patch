+    assert!(results.iter().any(|t| t.contains("not one this run holds")), "a sub-agent exceeded its parent: a grant the parent lacks was accepted: {results:?}");
+    assert!(results.iter().any(|t| t.contains("was not given mail__send")), "a sub-agent exceeded its parent: it used a tool it was not given: {results:?}");
