+/// A post that names no recipient, after untrusted input and private data,
+/// goes without asking when what it sends carries nothing private; the
+/// outgoing classifier decides, and Auto Review still judges it
+/// (decisions/2026-11-19-an-outage-asks-no-one.md).
+#[tokio::test(flavor = "multi_thread")]
+async fn an_unnamed_post_carrying_nothing_private_goes_without_asking() {
+    let w = world().await;
+    let news = w.web.url("/news");
+    let model = FakeModel::start(steps(vec![
+        plan("tell the team the build passed"),
+        tool("mail__list_inbox", json!({})),
+        tool("web_fetch", json!({ "url": news })),
+        tool("chat__post", json!({ "channel": "team", "text": "The build passed." })),
+        fail("stopping"),
+    ]))
+    .await;
+    model.set_classifier(script(|c| async move { magnus_invariants::model::classify(c.text().contains("41.7M"), "a revenue figure is private business data") }));
+    let app = appliance(&w, &model).await;
+    let alice = app.api("alice");
+    let id = alice.submit("Check my inbox and the news, then tell the team the build passed.").await;
+    alice.wait_settled(&id).await;
+    assert!(alice.open_items(&id, "approval").await.is_empty(), "a post carrying nothing private asked the person");
+    assert_eq!(w.chat.effects("post"), 1, "a post carrying nothing private was held");
+    assert!(model.reviews().iter().any(|r| r.text().contains("chat__post")), "the post went out without Auto Review");
 }
 
