diff --git a/tests/invariants/tests/support/surrogate_tls.rs b/tests/invariants/tests/support/surrogate_tls.rs
new file mode 100644
--- /dev/null
+++ b/tests/invariants/tests/support/surrogate_tls.rs
@@ -0,0 +1,74 @@
+//! TLS front end for the credential test's HTTP recorder.
+use magnus_invariants::web::FakeWeb;
+use std::path::{Path, PathBuf};
+use std::process::Stdio;
+use tokio::io::AsyncBufReadExt;
+
+pub struct TlsWeb {
+    pub address: String,
+    pub ca: PathBuf,
+    _dir: tempfile::TempDir,
+    _server: tokio::process::Child,
+}
+
+fn openssl(dir: &Path, args: &[&str]) {
+    let out = std::process::Command::new("openssl").args(args).current_dir(dir).output().expect("run openssl");
+    assert!(out.status.success(), "openssl {args:?}: {}", String::from_utf8_lossy(&out.stderr));
+}
+
+impl TlsWeb {
+    pub async fn start(site: &FakeWeb, name: &str) -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let d = dir.path();
+        openssl(d, &["req", "-x509", "-newkey", "rsa:2048", "-nodes", "-keyout", "ca.key", "-out", "ca.pem", "-subj", "/CN=credential test authority", "-days", "2"]);
+        openssl(d, &["req", "-newkey", "rsa:2048", "-nodes", "-keyout", "site.key", "-out", "site.csr", "-subj", &format!("/CN={name}")]);
+        std::fs::write(d.join("ext"), format!("subjectAltName=DNS:{name}\n")).unwrap();
+        openssl(d, &["x509", "-req", "-in", "site.csr", "-CA", "ca.pem", "-CAkey", "ca.key", "-CAcreateserial", "-out", "site.pem", "-days", "2", "-extfile", "ext"]);
+        // The HTTP recorder still observes the exact Authorization header. The
+        // proxy must verify the TLS certificate before it can reach that recorder.
+        let script = r#"
+import http.client, http.server, ssl, sys, urllib.parse
+target = urllib.parse.urlsplit(sys.argv[1])
+class Relay(http.server.BaseHTTPRequestHandler):
+    def do_GET(self):
+        conn = http.client.HTTPConnection(target.hostname, target.port, timeout=10)
+        try:
+            conn.request('GET', self.path, headers=dict(self.headers))
+            answer = conn.getresponse()
+            body = answer.read()
+            self.send_response(answer.status)
+            for key, value in answer.getheaders():
+                if key.lower() not in ('content-length', 'transfer-encoding', 'connection'):
+                    self.send_header(key, value)
+            self.send_header('Content-Length', str(len(body)))
+            self.send_header('Connection', 'close')
+            self.end_headers()
+            self.wfile.write(body)
+            self.close_connection = True
+        finally:
+            conn.close()
+    def log_message(self, *args):
+        pass
+server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), Relay)
+context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+context.load_cert_chain('site.pem', 'site.key')
+server.socket = context.wrap_socket(server.socket, server_side=True)
+print('127.0.0.1:' + str(server.server_port), flush=True)
+server.serve_forever()
+"#;
+        let mut server = tokio::process::Command::new("python3")
+            .args(["-c", script, &site.base])
+            .current_dir(d)
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .kill_on_drop(true)
+            .spawn()
+            .unwrap();
+        let mut output = tokio::io::BufReader::new(server.stdout.take().unwrap());
+        let mut address = String::new();
+        tokio::time::timeout(std::time::Duration::from_secs(10), output.read_line(&mut address)).await.unwrap().unwrap();
+        let address = address.trim().to_string();
+        assert!(address.starts_with("127.0.0.1:"), "TLS fixture did not start: {address}");
+        TlsWeb { address, ca: d.join("ca.pem"), _dir: dir, _server: server }
+    }
+}
