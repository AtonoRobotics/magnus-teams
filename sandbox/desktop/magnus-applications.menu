<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
  "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">
<!-- The Magnus menu: the three pinned apps, then every other app on the
     computer, the agent's installs among them, by kind. No settings. -->
<Menu>
  <Name>Magnus</Name>
  <DefaultAppDirs/>
  <DefaultDirectoryDirs/>
  <Include>
    <Category>X-Magnus-Pinned</Category>
  </Include>
  <Layout>
    <Filename>magnus-terminal.desktop</Filename>
    <Filename>magnus-files.desktop</Filename>
    <Filename>magnus-browser.desktop</Filename>
    <Separator/>
    <Menuname>Installed</Menuname>
    <Menuname>Office</Menuname>
    <Menuname>Graphics</Menuname>
    <Menuname>Development</Menuname>
    <Menuname>Other</Menuname>
  </Layout>
  <Menu>
    <Name>Installed</Name>
    <Directory>magnus-installed.directory</Directory>
    <Include><Category>X-Magnus-Installed</Category></Include>
  </Menu>
  <Menu>
    <Name>Office</Name>
    <Directory>xfce-office.directory</Directory>
    <Include><Category>Office</Category></Include>
    <Exclude><Category>X-Magnus-Installed</Category></Exclude>
  </Menu>
  <Menu>
    <Name>Graphics</Name>
    <Directory>xfce-graphics.directory</Directory>
    <Include><Category>Graphics</Category></Include>
    <Exclude><Category>X-Magnus-Installed</Category><Category>Office</Category></Exclude>
  </Menu>
  <Menu>
    <Name>Development</Name>
    <Directory>xfce-development.directory</Directory>
    <Include><Category>Development</Category></Include>
    <Exclude><Category>X-Magnus-Installed</Category><Category>Office</Category><Category>Graphics</Category></Exclude>
  </Menu>
  <Menu>
    <Name>Other</Name>
    <Directory>xfce-other.directory</Directory>
    <OnlyUnallocated/>
    <Include><All/></Include>
    <Exclude>
      <Category>Settings</Category>
      <Category>X-XFCE-SettingsDialog</Category>
      <Category>X-XFCE-SystemSettings</Category>
      <Category>DesktopSettings</Category>
      <Category>System</Category>
      <Category>X-Magnus-Pinned</Category>
      <Filename>xfce4-terminal.desktop</Filename>
      <Filename>thunar.desktop</Filename>
      <Filename>thunar-bulk-rename.desktop</Filename>
      <Filename>chromium.desktop</Filename>
      <Filename>xfce4-run.desktop</Filename>
      <Filename>xfce4-about.desktop</Filename>
      <Filename>xfce4-session-logout.desktop</Filename>
      <Filename>xfce4-web-browser.desktop</Filename>
      <Filename>xfce4-file-manager.desktop</Filename>
      <Filename>xfce4-terminal-emulator.desktop</Filename>
      <Filename>xfce4-mail-reader.desktop</Filename>
      <Filename>display-im6.q16.desktop</Filename>
      <Filename>debian-xterm.desktop</Filename>
      <Filename>debian-uxterm.desktop</Filename>
    </Exclude>
  </Menu>
</Menu>
